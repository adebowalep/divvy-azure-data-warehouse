<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="867" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;Divvy Bike Share: solution architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="700" height="40" as="geometry"/></mxCell><mxCell id="lane1" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Azure data warehouse: built and validated in Azure Synapse&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#566779&#x27;&gt;Temporary Udacity cloud-lab resources, since deleted. Evidence is in evidence/.&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;fillColor=#F1F7FC;strokeColor=#C9DCEC;" vertex="1" parent="1"><mxGeometry x="12" y="60" width="1716" height="445" as="geometry"/></mxCell><mxCell id="lane2" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Interactive dashboard: a separate presentation branch with no live Azure connection&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#566779&#x27;&gt;Uses the same business rules as the SQL; headline figures were cross-checked against Synapse results.&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=284;spacingTop=8;fontSize=12;fillColor=#FBF5EA;strokeColor=#E7D5B3;" vertex="1" parent="1"><mxGeometry x="12" y="545" width="1716" height="254" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b style=&#x27;font-size:15px;color:#0D1B2B&#x27;&gt;Source CSV files&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;riders.csv  (75,000)&lt;br&gt;trips.csv  (4,584,921)&lt;br&gt;payments.csv  (1,946,607)&lt;br&gt;stations.csv  (838)&lt;br&gt;&amp;nbsp;&lt;br&gt;Real Divvy trips plus&lt;br&gt;synthetic rider, account&lt;br&gt;and payment data" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#566779;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="200" height="220" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b style=&#x27;font-size:15px;color:#0F3A5F&#x27;&gt;Azure Database&lt;br&gt;for PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;OLTP source system&lt;br&gt;&amp;nbsp;&lt;br&gt;tables: rider, trip,&lt;br&gt;payment, station&lt;br&gt;&amp;nbsp;&lt;br&gt;loaded with a Python&lt;br&gt;script (COPY)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="116" width="200" height="220" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&#x27;font-size:15px;color:#0F3A5F&#x27;&gt;Azure Synapse&lt;br&gt;Ingest&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;copy data tool&lt;br&gt;one-time pipeline run&lt;br&gt;&amp;nbsp;&lt;br&gt;4 copy activities&lt;br&gt;PostgreSQL to data lake" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="116" width="200" height="220" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&#x27;font-size:15px;color:#0F3A5F&#x27;&gt;Azure Data Lake&lt;br&gt;Storage Gen2&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;raw: 4 delimited text files&lt;br&gt;public.rider.txt&lt;br&gt;public.trip.txt&lt;br&gt;public.payment.txt&lt;br&gt;public.station.txt&lt;br&gt;&amp;nbsp;&lt;br&gt;warehouse/: Parquet output&lt;br&gt;written by the CETAS step" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="200" height="220" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style=&#x27;font-size:15px;color:#0F3A5F&#x27;&gt;Synapse serverless&lt;br&gt;SQL pool (built-in)&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;database: divvy_dw&lt;br&gt;&amp;nbsp;&lt;br&gt;4 external staging tables:&lt;br&gt;staging_rider&lt;br&gt;staging_trip&lt;br&gt;staging_payment&lt;br&gt;staging_station" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="116" width="200" height="220" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style=&#x27;font-size:15px;color:#FFFFFF&#x27;&gt;5 CETAS transformations&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;CREATE EXTERNAL TABLE ... AS SELECT&lt;br&gt;&amp;nbsp;&lt;br&gt;Dimensions&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dim_rider  ·  dim_station  ·  dim_date&lt;br&gt;Facts&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;fact_trip  ·  fact_payment&lt;br&gt;&amp;nbsp;&lt;br&gt;Parquet files in warehouse/&amp;lt;table&amp;gt;/run01/&lt;br&gt;a new run folder for every re-run" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#E6F2FA;fillColor=#0F3A5F;strokeColor=#0F3A5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1380" y="116" width="330" height="220" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b style=&#x27;font-size:15px;color:#0D1B2B&#x27;&gt;Source CSV files&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;the same four files,&lt;br&gt;read locally&lt;br&gt;&amp;nbsp;&lt;br&gt;not stored in the&lt;br&gt;repository" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#566779;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="200" height="150" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b style=&#x27;font-size:15px;color:#7A4F0E&#x27;&gt;Python aggregation&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;dashboard/build_data.py&lt;br&gt;pandas + NumPy&lt;br&gt;&amp;nbsp;&lt;br&gt;same business rules as&lt;br&gt;the warehouse SQL" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="625" width="200" height="150" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b style=&#x27;font-size:15px;color:#7A4F0E&#x27;&gt;data.json&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;aggregates only&lt;br&gt;about 311 KB&lt;br&gt;no rider-level rows&lt;br&gt;split by rider type" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="625" width="200" height="150" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b style=&#x27;font-size:15px;color:#7A4F0E&#x27;&gt;Static page build&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;make_dashboard.py +&lt;br&gt;template.html&lt;br&gt;makes dashboard/index.html&lt;br&gt;data embedded" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="625" width="200" height="150" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b style=&#x27;font-size:15px;color:#115C3B&#x27;&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;static hosting from&lt;br&gt;the main branch&lt;br&gt;&amp;nbsp;&lt;br&gt;no database,&lt;br&gt;no backend" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1B8A5A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="625" width="200" height="150" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b style=&#x27;font-size:15px;color:#115C3B&#x27;&gt;Divvy Ride Atlas&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;runs in the visitor&amp;#x27;s browser:&lt;br&gt;rider-type filter, 7 tabs,&lt;br&gt;heatmap, station map, routes,&lt;br&gt;rebalancing, payments, accounts" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1B8A5A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1380" y="625" width="330" height="150" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style=&#x27;font-size:15px;color:#0F3A5F&#x27;&gt;T-SQL analytics and validation (serverless SQL)&lt;/b&gt;&lt;br&gt;&lt;div style=&#x27;line-height:6px&#x27;&gt;&amp;nbsp;&lt;/div&gt;07_business_queries.sql: ride duration, stations, routes, spend, usage vs spend&lt;br&gt;06_validation_summary.sql: 26 checks, all passing in the Synapse run" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#0D1B2B;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="382" width="600" height="99" as="geometry"/></mxCell><mxCell id="e1" value="1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="6" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;exitX=0.5000;exitY=1;entryX=0.7250;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="same files" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;dashed=1;" edge="1" parent="1" source="n1" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="A" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="B" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="C" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="D" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="E" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#566779;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#566779;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="823" width="22" height="14" as="geometry"/></mxCell><mxCell id="lt0" value="Source files" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="819" width="94" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#1783BC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="176" y="823" width="22" height="14" as="geometry"/></mxCell><mxCell id="lt1" value="Azure service" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="204" y="819" width="101" height="22" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;html=1;fillColor=#0F3A5F;strokeColor=#0F3A5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="329" y="823" width="22" height="14" as="geometry"/></mxCell><mxCell id="lt2" value="Warehouse tables" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="357" y="819" width="122" height="22" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="503" y="823" width="22" height="14" as="geometry"/></mxCell><mxCell id="lt3" value="Python / local build" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="531" y="819" width="150" height="22" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#1B8A5A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="705" y="823" width="22" height="14" as="geometry"/></mxCell><mxCell id="lt4" value="Static hosting" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="733" y="819" width="108" height="22" as="geometry"/></mxCell><mxCell id="lnote" value="Numbers 1-6: warehouse steps in order.  Letters A-E: dashboard steps in order." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#566779;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="875" y="819" width="560" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><